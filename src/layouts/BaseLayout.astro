---
import '../styles/global.css';
const {
  title = 'Steine-Ankauf.de',
  description = 'LEGO und DUPLO verkaufen: schnell, fair und unkompliziert.'
} = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
  </head>
  <body>
    <slot />
  </body>
</html>
