---
import '../styles/global.css';
const {
  title = 'Steine-Ankauf.de',
  description = 'LEGO und DUPLO verkaufen: schnell, fair und unkompliziert.',
  canonical = '',
  image = 'og-image.svg'
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://www.steine-ankauf.de');
const basePath = import.meta.env.BASE_URL;
const baseUrl = new URL(basePath, siteUrl);
const cleanCanonical = String(canonical).replace(/^\/+/, '');
const cleanImage = String(image).replace(/^\/+/, '');
const canonicalUrl = new URL(cleanCanonical, baseUrl).toString();
const imageUrl = new URL(cleanImage, baseUrl).toString();
const asset = (path) => `${basePath}${String(path).replace(/^\/+/, '')}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={asset('site.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Steine-Ankauf.de" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f2cd37" />
  </head>
  <body>
    <slot />
  </body>
</html>
