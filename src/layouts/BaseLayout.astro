---
import '../styles/global.css';
const {
  title = 'Steine-Ankauf.de',
  description = 'LEGO und DUPLO verkaufen: schnell, fair und unkompliziert.',
  canonical = '',
  image = 'og-image.svg'
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://www.steine-ankauf.de');
const basePath = import.meta.env.BASE_URL;
const baseUrl = new URL(basePath, siteUrl);
const cleanCanonical = String(canonical).replace(/^\/+/, '');
const cleanImage = String(image).replace(/^\/+/, '');
const canonicalUrl = new URL(cleanCanonical, baseUrl).toString();
const imageUrl = new URL(cleanImage, baseUrl).toString();
const asset = (path) => `${basePath}${String(path).replace(/^\/+/, '')}`;
const photoVars = `
