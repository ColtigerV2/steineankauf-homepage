---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
---
<BaseLayout title="Danke | Steine-Ankauf.de">
  <Header />
  <main>
    <section>
      <div class="container">
        <h1>Danke für deine Anfrage!</h1>
        <p>Bitte drucke den Begleitschein aus und lege ihn deiner Sendung bei. Wir melden uns nach Eingang bzw. Prüfung per E-Mail.</p>
        <a class="btn btn-primary" href="../">Zurück zur Startseite</a>
      </div>
    </section>
  </main>
</BaseLayout>
