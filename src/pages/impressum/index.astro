---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
---
<BaseLayout title="Impressum | Steine-Ankauf.de" description="Impressum von Steine-Ankauf.de">
  <Header />
  <main class="legal-page">
    <section class="hero brick-bg">
      <div class="container legal-box">
        <span class="eyebrow">Rechtliches</span>
        <h1>Impressum</h1>
        <div class="legal-card">
          <h2>Angaben gemäß § 5 TMG</h2>
          <p>
            <strong>STEINE-ANKAUF.de</strong><br />
            Pierre-Pascal Hauer<br />
            Im Winkel 4<br />
            51399 Burscheid<br />
            Deutschland
          </p>

          <h2>Kontakt</h2>
          <p>
            E-Mail: <a href="mailto:info@steine-ankauf.de">info@steine-ankauf.de</a><br />
            Telefon: wird vor Go-live ergänzt
          </p>

          <h2>Umsatzsteuer-ID</h2>
          <p>Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz: wird vor Go-live ergänzt, falls vorhanden.</p>

          <h2>Verantwortlich für den Inhalt</h2>
