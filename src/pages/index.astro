---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'STEINE-ANKAUF.de',
  description: 'Ankauf von LEGO, DUPLO, Kiloware, Sets und Sammlungen per Versand oder Ladenabgabe.',
  url: 'https://www.steine-ankauf.de',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Im Winkel 4',
    postalCode: '51399',
    addressLocality: 'Burscheid',
    addressCountry: 'DE'
  },
  founder: 'Pierre-Pascal Hauer',
  areaServed: 'Deutschland'
};
---
<BaseLayout title="LEGO verkaufen | Steine-Ankauf.de" description="LEGO, DUPLO und Klemmbausteine verkaufen: online anmelden, Begleitschein drucken, einsenden oder im Laden abgeben.">
  <Header />
  <main id="top">
    <section class="hero brick-bg">
      <div class="container hero-grid">
        <div>
          <span class="eyebrow">Brickstore-Feeling · Ankauf per Versand oder Ladenabgabe</span>
          <h1>LEGO® & DUPLO® verkaufen – <span class="marker">einfach, fair, persönlich.</span></h1>
          <p class="lead">Ob Kinderzimmersammlung, Kiloware, Sets, Bauanleitungen oder Kartons: Wir machen den Verkauf unkompliziert. Online anmelden, Begleitschein ausdrucken, Paket beilegen – fertig.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#formular">Ankauf starten</a>
            <a class="btn btn-secondary" href="#ablauf">So funktioniert's</a>
          </div>
          <div class="checks" aria-label="Vorteile">
            <div class="check">✓ Festpreis-Orientierung</div>
            <div class="check">✓ Echter Laden in Burscheid</div>
            <div class="check">✓ Schnelle Bearbeitung</div>
            <div class="check">✓ Kein anonymes Ankaufportal</div>
          </div>
        </div>
        <div class="hero-panel" aria-label="Ankauf-Zusammenfassung">
          <div class="hero-panel-badge">STEINE-ANKAUF.de</div>
          <h2>Deine Sammlung bekommt ein zweites Leben.</h2>
          <p>Einpacken, Begleitschein beilegen und einsenden oder persönlich abgeben.</p>
          <div class="panel-chips">
            <span>Kiloware</span>
            <span>DUPLO®</span>
            <span>Sets</span>
            <span>Minifiguren</span>
          </div>
        </div>
      </div>
    </section>

    <section id="ablauf">
      <div class="container">
        <div class="section-head">
          <h2><span class="marker">Einpacken.</span> Beilegen. Auszahlen.</h2>
          <p class="muted">Der Papierzettel bleibt – aber als moderner Paket-Begleitschein.</p>
        </div>
        <div class="grid-4">
          <article class="card"><div class="step-number">1</div><h3>Ware grob beschreiben</h3><p>Was ist dabei? Kiloware, Sets, DUPLO, Figuren, Bauanleitungen oder Kartons.</p></article>
          <article class="card"><div class="step-number">2</div><h3>Online anmelden</h3><p>Kontaktdaten und kurze Beschreibung eintragen. Fotos helfen bei größeren Sammlungen.</p></article>
          <article class="card"><div class="step-number">3</div><h3>Begleitschein drucken</h3><p>Der Zettel kommt oben ins Paket. So kann Pierre die Ware sofort zuordnen.</p></article>
          <article class="card"><div class="step-number">4</div><h3>Auszahlung erhalten</h3><p>Nach Prüfung erfolgt die Auszahlung per PayPal oder Banküberweisung.</p></article>
        </div>
      </div>
    </section>

    <section id="preise" class="price-section">
      <div class="container price-grid">
        <div>
          <span class="eyebrow">Richtwerte für Kinderzimmersammlungen</span>
          <h2>Klare Preise statt Rätselraten.</h2>
          <p class="lead">Für typische Sammlungen arbeiten wir mit einfachen Richtwerten. Größere Händlerposten, stark selektierte Bestände oder besondere Sammlerstücke werden individuell bewertet.</p>
          <p class="muted">Hinweis: Preise vor Go-live final von Pierre bestätigen lassen.</p>
        </div>
        <div class="price-cards">
          <article class="price-card red-card"><strong>LEGO® Kiloware</strong><span>6,00 € / kg</span></article>
          <article class="price-card blue-card"><strong>Baupläne & Kartons</strong><span>3,00 € / kg</span></article>
        </div>
      </div>
    </section>

    <section id="ankauf" class="white-section">
      <div class="container">
        <div class="section-head">
          <h2>Was kaufen wir an?</h2>
          <p class="muted">Alles rund um die bunten Steine – sauber, vollständig oder als gemischte Sammlung.</p>
        </div>
        <div class="grid-3">
          <article class="card category"><h3>LEGO® Kiloware</h3><p>Gemischte Steine aus Kinderzimmer, Keller oder Dachboden.</p></article>
          <article class="card category"><h3>DUPLO®</h3><p>Große Steine, Sets, Figuren, Schienen und Zubehör.</p></article>
          <article class="card category"><h3>Sets & Sammlungen</h3><p>Aufgebaut, zerlegt, mit oder ohne Karton – gerne mit Bauanleitung.</p></article>
          <article class="card category"><h3>Minifiguren</h3><p>Figuren, Zubehör, Themenwelten und besondere Einzelteile.</p></article>
          <article class="card category"><h3>Technic & Spezialteile</h3><p>Technic, Platten, Räder, Schienen, Container und sortierte Bestände.</p></article>
          <article class="card category"><h3>Bauanleitungen & Kartons</h3><p>Auch Papier, Boxen und Anleitungen können relevant sein.</p></article>
        </div>
      </div>
    </section>

    <section class="rules-section">
      <div class="container rules-grid">
        <div>
          <h2>Was wichtig ist, bevor du verschickst</h2>
          <p class="lead">Wir halten den Ablauf bewusst einfach. Ein paar Grundregeln helfen aber, damit deine Sendung schnell geprüft werden kann.</p>
        </div>
        <div class="rules-list">
          <div class="rule">Du musst mindestens 18 Jahre alt sein.</div>
          <div class="rule">Die Steine müssen nicht sortiert oder gewaschen sein.</div>
          <div class="rule">Sie sollten sauber und frei von Fremdteilen sein.</div>
          <div class="rule">Aufgebaute Sachen müssen nicht zerlegt werden.</div>
          <div class="rule">Packe lieber wenige große Kartons statt viele kleine.</div>
          <div class="rule">Begleitschein bitte oben ins Paket legen.</div>
        </div>
      </div>
    </section>

    <section id="laden">
      <div class="container band">
        <div>
          <h2>Echter Laden. Echter Ansprechpartner.</h2>
          <p>Steine-Ankauf ist kein anonymes Portal. Hinter der Seite steht ein Laden in Burscheid und ein Team, das sich täglich mit LEGO®, gebrauchten Sets und Sammlungen beschäftigt.</p>
          <p><strong>Adresse:</strong><br />STEINE-ANKAUF.de<br />Pierre-Pascal Hauer<br />Im Winkel 4<br />51399 Burscheid</p>
        </div>
        <div class="card">
          <h3>Warum das wichtig ist</h3>
          <p>Viele Verkäufer möchten wissen, wohin ihre Sammlung geht. Genau hier punktet die Seite: persönlich, greifbar, lokal und transparent.</p>
          <a class="btn btn-primary" href="#formular">Anfrage starten</a>
        </div>
      </div>
    </section>

    <section class="social-section white-section">
      <div class="container social-grid">
        <div class="card social-card"><span class="social-badge">TikTok · Instagram · Ladenalltag</span><h2>Hier werden Steine wirklich gelebt.</h2><p>Pierre zeigt online regelmäßig Laden, Sortierung, Ankäufe und Sammlerstücke. Genau diese Echtheit gehört auf die Seite: nicht nur Ankauf, sondern echte Brick-Community.</p></div>
        <article class="profile-card" aria-label="Pierre-Pascal Hauer">
          <div class="profile-photo" role="img" aria-label="Pierre-Pascal Hauer von Steine-Ankauf.de"></div>
          <div class="profile-content">
            <span class="social-badge">Persönlich statt anonym</span>
            <h3>Pierre-Pascal Hauer</h3>
            <p>Hinter STEINE-ANKAUF.de steht ein echter Laden, echte Erfahrung und jemand, der gebrauchte LEGO®-Sammlungen täglich in der Hand hat.</p>
          </div>
        </article>
      </div>
    </section>

    <section id="formular" class="white-section">
      <div class="container form-wrap">
        <div>
          <h2>Ankauf starten</h2>
          <p class="lead">Fülle die Anfrage aus. Danach kannst du direkt einen Begleitschein für dein Paket drucken.</p>
          <div class="form-steps">
            <div><strong>1.</strong> Anfrage ausfüllen</div>
            <div><strong>2.</strong> Begleitschein drucken</div>
            <div><strong>3.</strong> Paket beilegen</div>
          </div>
          <div class="notice"><strong>Preview-Hinweis:</strong> Auf GitHub Pages läuft das Formular im Demo-Modus. Für all-inkl liegt ein PHP-Mailhandler unter <code>/public/api/submit.php</code> bei.</div>
        </div>
        <form class="form" id="ankaufForm" method="post" action="/api/submit.php">
          <div class="honeypot" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <fieldset>
            <legend>Kontakt</legend>
            <div class="row"><div><label for="name">Name *</label><input id="name" name="name" autocomplete="name" required /></div><div><label for="email">E-Mail *</label><input id="email" type="email" name="email" autocomplete="email" required /></div></div>
            <div class="row"><div><label for="telefon">Telefon optional</label><input id="telefon" name="telefon" autocomplete="tel" /></div><div><label for="adresse">Straße / Ort optional</label><input id="adresse" name="adresse" autocomplete="street-address" /></div></div>
          </fieldset>

          <fieldset>
            <legend>Auszahlung</legend>
            <div class="row"><div><label for="auszahlung">Gewünschte Auszahlung</label><select id="auszahlung" name="auszahlung"><option>PayPal</option><option>Banküberweisung</option><option>Noch offen</option></select></div><div><label for="kontoinhaber">Kontoinhaber optional</label><input id="kontoinhaber" name="kontoinhaber" /></div></div>
            <div class="row"><div><label for="paypal">PayPal-Adresse optional</label><input id="paypal" name="paypal" /></div><div><label for="iban">IBAN optional</label><input id="iban" name="iban" /></div></div>
          </fieldset>

          <fieldset>
            <legend>Ware</legend>
            <div class="row"><div><label for="kategorie">Was möchtest du verkaufen?</label><select id="kategorie" name="kategorie"><option>LEGO Kiloware</option><option>DUPLO</option><option>Sets / Sammlung</option><option>Minifiguren</option><option>Bauanleitungen / Kartons</option><option>Gemischt</option><option>Händlerposten / großer Bestand</option></select></div><div><label for="menge">Menge grob</label><input id="menge" name="menge" placeholder="z. B. 4 Kartons / ca. 25 kg" /></div></div>
            <label for="beschreibung">Beschreibung</label><textarea id="beschreibung" name="beschreibung" placeholder="z. B. gemischte Steine, einige Sets, Bauanleitungen vorhanden, Zustand, Besonderheiten"></textarea>
            <div class="row"><div><label for="uebergabe">Versand oder Abgabe?</label><select id="uebergabe" name="uebergabe"><option>Versand</option><option>Ladenabgabe</option><option>Noch offen</option></select></div><div><label for="pakete">Anzahl Pakete optional</label><input id="pakete" name="pakete" placeholder="z. B. 2" /></div></div>
          </fieldset>

          <label class="checkline"><input type="checkbox" name="agb" value="ja" required /> Ich bin mindestens 18 Jahre alt und akzeptiere die Ankaufbedingungen.</label>
          <div class="hero-actions"><button class="btn btn-primary" type="submit">Anfrage vorbereiten</button><button class="btn btn-secondary" type="button" id="printSlip">Begleitschein drucken</button></div>
          <p class="form-note">Tipp: Für den Versand den Begleitschein nach dem Ausfüllen drucken und oben ins Paket legen.</p>
        </form>
      </div>
    </section>

    <section class="final-cta">
      <div class="container final-cta-box">
        <div>
          <span class="eyebrow">Bereit zum Verpacken?</span>
          <h2>Starte jetzt deinen LEGO® Ankauf.</h2>
          <p>Wenn du unsicher bist, beschreibe die Sammlung einfach grob. Den Rest klären wir persönlich.</p>
        </div>
        <a class="btn btn-primary" href="#formular">Anfrage ausfüllen</a>
      </div>
    </section>

    <section id="faq" class="faq">
      <div class="container">
        <div class="section-head"><h2>Häufige Fragen</h2><p class="muted">Kurz, klar, ohne Kleingedruckt-Gefühl.</p></div>
        <details open><summary>Muss das LEGO sortiert sein?</summary><p>Nein. Es muss nicht gewaschen oder sortiert sein, sollte aber sauber und frei von Fremdteilen sein.</p></details>
        <details><summary>Müssen aufgebaute Sets zerlegt werden?</summary><p>Nein. Aufgebaute Sachen müssen nicht extra auseinandergenommen werden.</p></details>
        <details><summary>Wie soll ich die Ware versenden?</summary><p>Am besten in wenige größere Kartons packen. Den ausgedruckten Begleitschein bitte oben ins Paket legen.</p></details>
        <details><summary>Kann ich auch persönlich abgeben?</summary><p>Ja, eine Abgabe im Laden bzw. nach Absprache ist möglich.</p></details>
        <details><summary>Was passiert bei Händlerposten oder besonderen Sammlungen?</summary><p>Dann bitte vorher eine Anfrage mit Beschreibung und Fotos schicken. Solche Bestände werden individuell bewertet.</p></details>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer-grid">
      <div>
        <div class="logo"><span class="red">STEINE</span><span>-</span><span class="blue">ANKAUF</span><span>.de</span></div>
        <p class="muted">LEGO® & DUPLO® verkaufen – per Versand oder Ladenabgabe in Burscheid.</p>
      </div>
      <div>
        <h3>Kontakt</h3>
        <p>STEINE-ANKAUF.de<br />Pierre-Pascal Hauer<br />Im Winkel 4<br />51399 Burscheid</p>
      </div>
      <div>
        <h3>Navigation</h3>
        <p><a href="#ablauf">Ablauf</a><br /><a href="#preise">Preise</a><br /><a href="#formular">Ankauf starten</a><br /><a href="#faq">FAQ</a></p>
      </div>
      <div>
        <h3>Rechtliches</h3>
        <p><a href="impressum/">Impressum</a><br /><a href="datenschutz/">Datenschutz</a></p>
      </div>
    </div>
    <div class="container footer-bottom">
      <p>LEGO® ist eine Marke der LEGO Gruppe. Diese Website wird nicht von der LEGO Gruppe gesponsert, autorisiert oder unterstützt.</p>
    </div>
  </footer>

  <div class="print-sheet" id="printSheet">
    <div class="print-header">
      <div><h1>STEINE-ANKAUF.de</h1><p>Paket-Begleitschein</p></div>
      <div class="print-case"><strong>Vorgangsnummer</strong><br /><span id="caseId">SA-PREVIEW</span></div>
    </div>
    <p class="print-hint">Bitte diesen Zettel ausdrucken, unterschreiben und oben in das Paket legen.</p>
    <h2>Kontakt & Auszahlung</h2>
    <div class="print-grid">
      <div class="print-box"><strong>Name:</strong> <span data-out="name"></span></div>
      <div class="print-box"><strong>E-Mail:</strong> <span data-out="email"></span></div>
      <div class="print-box"><strong>Telefon:</strong> <span data-out="telefon"></span></div>
      <div class="print-box"><strong>Adresse:</strong> <span data-out="adresse"></span></div>
      <div class="print-box"><strong>Auszahlung:</strong> <span data-out="auszahlung"></span></div>
      <div class="print-box"><strong>Kontoinhaber:</strong> <span data-out="kontoinhaber"></span></div>
      <div class="print-box"><strong>PayPal:</strong> <span data-out="paypal"></span></div>
      <div class="print-box"><strong>IBAN:</strong> <span data-out="iban"></span></div>
    </div>
    <h2>Ware</h2>
    <div class="print-grid">
      <div class="print-box"><strong>Kategorie:</strong> <span data-out="kategorie"></span></div>
      <div class="print-box"><strong>Menge:</strong> <span data-out="menge"></span></div>
      <div class="print-box"><strong>Übergabe:</strong> <span data-out="uebergabe"></span></div>
      <div class="print-box"><strong>Anzahl Pakete:</strong> <span data-out="pakete"></span></div>
    </div>
    <div class="print-box print-description"><strong>Beschreibung:</strong><br /><span data-out="beschreibung"></span></div>
    <p><strong>Empfänger:</strong><br />STEINE-ANKAUF.de · Pierre-Pascal Hauer · Im Winkel 4 · 51399 Burscheid · Deutschland</p>
    <p>Mit meiner Unterschrift bestätige ich, dass ich mindestens 18 Jahre alt bin und die Ankaufbedingungen gelesen habe.</p>
    <p>Ort/Datum: ____________________________ Unterschrift: ____________________________</p>
    <hr />
    <p><strong>Intern:</strong> Gewicht: ______ kg · Betrag: ______ € · geprüft von: ______ · Ausbezahlt am: __________</p>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script>
  <script>
    const form = document.querySelector('#ankaufForm');
    const fillPrint = () => {
      const data = new FormData(form);
      const now = new Date();
      const stamp = `${now.getFullYear()}${String(now.getMonth()+1).padStart(2,'0')}${String(now.getDate()).padStart(2,'0')}-${String(now.getHours()).padStart(2,'0')}${String(now.getMinutes()).padStart(2,'0')}`;
      document.querySelector('#caseId').textContent = `SA-${stamp}`;
      document.querySelectorAll('[data-out]').forEach((el) => {
        el.textContent = data.get(el.dataset.out) || '—';
      });
    };
    document.querySelector('#printSlip').addEventListener('click', () => {
      if (!form.reportValidity()) return;
      fillPrint();
      window.print();
    });
    form.addEventListener('submit', (event) => {
      if (location.hostname.includes('github.io') || location.hostname === 'localhost') {
        event.preventDefault();
        if (!form.reportValidity()) return;
        fillPrint();
        alert('Demo: Anfrage vorbereitet. Drucke jetzt den Begleitschein und lege ihn dem Paket bei. Auf all-inkl wird daraus eine E-Mail an Pierre.');
      }
    });
  </script>
</BaseLayout>
