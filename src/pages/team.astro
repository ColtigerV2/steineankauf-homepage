---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Unser Team | Steine-Ankauf.de" description="Unser Team bei Steine-Ankauf.de"><Header /><main id="main-content" class="legal-page"><section><div class="container legal-box"><h1>Unser Team</h1><div class="legal-card"><p>Vom Ankauf über die Reinigung und Sortierung bis zum Versand: Hinter STEINE-ANKAUF.de steht ein eingespieltes Team.</p><ul><li>Pierre – Geschäftsführung</li><li>Robin – IT</li><li>Lars – Lager und Wäscherei</li><li>Jens – Marketing</li><li>Zuzanna – Versand</li><li>Brigitte & Manfred – Sortierung</li></ul><p>Einblicke in unseren Alltag findest du auf <a href="https://www.instagram.com/steineankauf/">Instagram</a> und <a href="https://www.tiktok.com/@steineankauf">TikTok</a>.</p></div><div class="hero-actions"><a class="btn btn-primary" href={base}>Zur Startseite</a><a class="btn btn-secondary" href={base + '#formular'}>Ankauf starten</a></div></div></section></main></BaseLayout>
